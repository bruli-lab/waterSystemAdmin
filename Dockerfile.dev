FROM golang:1.27.4

ARG UID=1000
ARG GID=1000

RUN groupadd -g "${GID}" dev \
    && useradd -m -u "${UID}" -g "${GID}" dev \
    && mkdir /app \
    && chown dev:dev /app

USER dev

ENV GOPATH=/home/dev/go
ENV PATH=/home/dev/go/bin:/usr/local/go/bin:$PATH

WORKDIR /app

COPY --chown=dev:dev go.mod go.sum ./
RUN go mod download

RUN go install github.com/air-verse/air@latest

EXPOSE 3000
CMD ["air", "-c", ".air.toml"]
